# ==============================================================================
# Realtime AI Voice Changer - Environment Configuration
# Copy this file to '.env' and adjust values for your hardware setup.
# ==============================================================================

# Audio Processing Sample Rate (Hz)
# Common RVC model sampling rates: 40000 (v1/v2 40k) or 48000 (v2 48k)
SAMPLE_RATE=40000

# Audio Chunk Size in Frames per callback
# Lower = lower latency, higher CPU/GPU callback frequency.
# Recommended: 256 (~6.4ms @ 40kHz) or 512 (~12.8ms @ 40kHz)
BLOCK_SIZE=256

# Channel Count (1 = Mono, required for voice processing)
CHANNELS=1

# Audio Device Configuration
# You can specify by device name substring (case-insensitive) or explicit numeric index.
# Run `python scripts/list_devices.py` to identify your exact device names & indices.
#
# Examples:
# INPUT_DEVICE_NAME="Microphone (Realtek Audio)"
# INPUT_DEVICE_INDEX=1
INPUT_DEVICE_NAME=""
INPUT_DEVICE_INDEX=

# Target Output: Typically "CABLE Input (VB-Audio Virtual Cable)"
# This routes the AI audio stream into the virtual microphone used by Discord/games.
OUTPUT_DEVICE_NAME="CABLE Input"
OUTPUT_DEVICE_INDEX=

# Pitch Shift (in Semitones)
# Default for Male-to-Female conversion is +12 (1 octave up).
# For subtle tone shift: +6 to +8; for standard M2F: +12; for deep F2M: -12.
PITCH_SHIFT_SEMITONES=12

# Inference Hardware Accelerator ("cuda" or "cpu")
DEVICE="cuda"

# SoundDevice Latency Preset ("low", "high", or float seconds e.g. 0.01)
LATENCY_PRESET="low"

# Ring Buffer Queue Headroom (Number of blocks in buffer)
# Prevents dropouts during transient GPU latency spikes. 64 blocks @ 256 = ~400ms buffer capacity.
QUEUE_MAX_BLOCKS=64

# Path to RVC Model Weights (.pth) and Retrieval Index (.index)
MODEL_PATH=""
INDEX_PATH=""
